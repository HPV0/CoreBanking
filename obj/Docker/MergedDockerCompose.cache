name: dockercompose6567960971039127585
services:
  coreBanking.database:
    environment:
      POSTGRES_DB: banking
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U "$$POSTGRES_USER" -d "$$POSTGRES_DB"
      timeout: 5s
      interval: 10s
      retries: 5
      start_period: 10s
    image: postgres:18
    networks:
      otel: null
    ports:
      - mode: ingress
        target: 5432
        published: "5433"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\HaykPetrosyan\source\repos\CoreBanking\.containers\coreBanking-db
        target: /var/lib/postgresql
        bind: {}
  coreBanking.redis:
    command:
      - sh
      - -c
      - |
          mkdir -p /usr/local/etc/redis &&
          echo "bind 0.0.0.0" > /usr/local/etc/redis/redis.conf &&
          echo "appendonly yes" >> /usr/local/etc/redis/redis.conf &&
          echo "appendfsync everysec" >> /usr/local/etc/redis/redis.conf &&
          echo "user default off" > /usr/local/etc/redis/users.acl &&
          echo "user redis on >redis ~* +@all" >> /usr/local/etc/redis/users.acl &&
          redis-server /usr/local/etc/redis/redis.conf --aclfile /usr/local/etc/redis/users.acl
    environment:
      REDIS_USER: redis
      REDIS_USER_PASSWORD: redis
    healthcheck:
      test:
        - CMD-SHELL
        - redis-cli --user "$$REDIS_USER" --pass "$$REDIS_USER_PASSWORD" ping | grep
          -q PONG
      timeout: 10s
      interval: 30s
      retries: 5
      start_period: 10s
    image: redis:latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 6379
        published: "6380"
        protocol: tcp
    restart: unless-stopped
    volumes:
      - type: bind
        source: C:\Users\HaykPetrosyan\source\repos\CoreBanking\.containers\coreBanking-cache
        target: /data
        bind: {}
networks:
  default:
    name: dockercompose6567960971039127585_default
  otel:
    name: dockercompose6567960971039127585_otel
    driver: bridge